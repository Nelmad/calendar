{
  "name": "@nelmad/calendar",
  "version": "0.2.0-alpha.2",
  "description": "React month calendar with ISO intervals, IANA time zones and an accessible day agenda",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.react-server.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.react-server.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "nelmad",
  "homepage": "https://github.com/Nelmad/calendar#readme",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && node scripts/bundle-css.mjs && node scripts/verify-dist.mjs",
    "dev": "vite build --config vite.lib.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json --noEmit",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.css\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "typecheck:contract": "node scripts/implementation/contracts.mjs",
    "check:timezones": "node --test scripts/implementation/timezones/primary.checks.mjs && node scripts/implementation/timezones/generate.mjs",
    "check:transitions": "node scripts/implementation/timezones/audit-transitions.mjs",
    "check:package": "node scripts/implementation/packed-consumers.mjs",
    "api:report": "node scripts/docs/api-report.mjs --write",
    "check:api": "node scripts/docs/api-report.mjs",
    "check:docs": "node scripts/docs/check-docs.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "react-aria": "3.49.0",
    "react-aria-components": "1.18.0",
    "react-stately": "3.47.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.59.1",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "8.6.18",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^3.2.1"
  },
  "keywords": [
    "react",
    "calendar",
    "month-view",
    "events",
    "tasks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nelmad/calendar.git"
  },
  "bugs": {
    "url": "https://github.com/Nelmad/calendar/issues"
  }
}
